# Copiar a `.env` (que está en .gitignore) y completar.
# En la nube estos mismos valores van como Secrets del repo — ver
# .github/workflows/hector.yml. NUNCA con valores reales acá: el repo es
# público y el token de Telegram abre el grupo entero.

# El bot que manda los avisos (se saca de @BotFather).
TELEGRAM_BOT_TOKEN=

# El supergrupo donde escribe. Empieza con -100.
VIGIA_CHAT_ID=

# Los tópicos del grupo. Son IDs numéricos de "Temas" de Telegram;
# `configurar_telegram.py` los lista. Si faltan, esos avisos caen al hilo
# general y todo parece funcionar: no hay error, solo tópicos vacíos.
VIGIA_TOPICO_ERRORES=
VIGIA_TOPICO_OFERTAS=
VIGIA_TOPICO_ELECTRONICOS=
VIGIA_TOPICO_HOGAR=
VIGIA_TOPICO_VUELOS=
# Creado pero todavia SIN USAR: no hay patrones de supermercado en
# categorias.py ni la variable esta en el workflow. Ver la bitacora.
VIGIA_TOPICO_SUPERMERCADO=

# reenviar_ofertas.py (Hector2): reenvío de ofertas/errores de un canal
# aliado externo (con su autorización) al grupo de Rat.IA. Corre como proceso
# siempre encendido, no como cron — ver el docstring del script para el
# hosting.
TG_API_ID=
TG_API_HASH=
CANALES_ORIGEN=

# Hector2: tópico donde caen los hallazgos que el filtro no pudo confirmar
# contra la base de Héctor ni verificar en vivo, pero tampoco descartó. Si
# queda vacío, esos mensajes se mandan igual a su tópico normal, marcados con
# "🔎 sin verificar del todo" — nunca se pierden por falta de esta variable.
VIGIA_TOPICO_DUDOSOS=
# Repo público de donde Hector2 baja el respaldo diario de precios.db para
# cruzar. Cambiar solo si el respaldo se muda de repo.
HECTOR2_REPO_BASE=joaquinmunozs/rat.ia

# El proxy de Cloudflare para easy.cl y paris.cl, que devuelven 403 a las
# IPs de GitHub Actions. Sin estas dos variables no se usa el proxy y todo
# funciona como antes (desde una conexion chilena esas tiendas responden
# bien directo).
HECTOR_PROXY_URL=
HECTOR_PROXY_TOKEN=
# Tope de peticiones al proxy por corrida. Existe porque el proxy llego a
# consumir el 99,8% de la cuota diaria de Cloudflare y dejo caido el webhook
# de ventas de Planeta Shop. Por defecto 15.000. Ver la bitacora del 20-ago.
HECTOR_PROXY_MAX_CORRIDA=
